# 币圈新闻爬虫环境变量模板
# 复制此文件为 .env 并填入实际值：cp config/env.example config/.env
#
# ⚠️ 2026-08-05 仓库转 public：**本仓库不再包含任何真实凭据**。
#    .env 只存在于各机器本地（已 gitignore，权限 600），代码里也不留任何
#    硬编码兜底——取不到就报错/拒绝鉴权，绝不 fail-open 到一个内置默认值。
#    原来那句"已在仓库中直接存储（私有仓库）"的做法已废弃。

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<your_mysql_password>
MYSQL_DATABASE=crypto_news

# OpenAI（gpt-5.4，TPM 500k）。client 构造全仓统一从这两个变量读，换 key/
# 换兼容端点不用改代码。2026-07-28 曾尝试切到公司 LiteLLM 网关，已回退——
# 网关地址是内网专用（私网 IP，Binance VPN 外连不通），这台跑生产 pipeline
# 的 GCP VM 连不上，详情见 crawler/pipeline.py 的 LLM_MODEL 注释。
# 若未来真要接内网网关，前提是网关对公网/VM 网段开放，或把 pipeline 挪到
# 能连内网的机器上跑。另外注意：若代理 Claude（如 claude-opus-4-8）经
# Bedrock 通道，可能不支持 response_format=json_schema 的 strict 模式——
# 本仓库从 pipeline 结构化到评测工具全部依赖 strict schema，换非 OpenAI
# 模型前务必先拿真实 schema 测过。
OPENAI_API_KEY=<your_openai_api_key>
OPENAI_API_BASE=https://api.openai.com/v1

# X API（Bearer Token，用于 KOL 推文拉取）
X_BEARER_TOKEN=<your_x_bearer_token>
# 主流水线增量扫描是否调用 X API（KOL 时间线 + 全网搜索）。false = 暂停，
# 省钱用；不影响策略产品工作台（评测工具/策略实验室）的按需调用，那些走的
# 是 OpenAI，不走这个开关。默认 true，不写这一行等于不暂停。
# X_FETCH_ENABLED=false

# dxFeed News（美股/宏观实时新闻，MT Newswires 聚合，HTTP Basic Auth，2026-07-28 接入）
DXFEED_NEWS_USER=<your_dxfeed_username>
DXFEED_NEWS_PASS=<your_dxfeed_password>

# CoinMarketCal（催化剂日历，free tier 3000 req/月）
COINMARKETCAL_API_KEY=<your_coinmarketcal_api_key>

# Massive 平台（Benzinga 实时新闻，query param 鉴权，2026-07-30 接入）
# 文档：https://massive.com/docs/rest/partners/benzinga/news
MASSIVE_API_KEY=<your_massive_api_key>

# Flask API 服务配置
API_HOST=0.0.0.0
API_PORT=8080
API_SECRET_KEY=<your_api_secret_key>

# ── API 访问令牌 ──────────────────────────────────────────────────────
# 分发给不同对接方，出问题可单独吊销其一，不必所有人一起换。
# 全部为空时服务会拒绝一切请求（VALID_API_KEYS 会剔除空值），这是刻意的：
# "忘了配" 必须表现为"谁都进不来"，而不是"谁都能进来"。
API_SECRET_KEY=
API_TOKEN_LAWRENCE=
API_TOKEN_TEAM_A=
API_TOKEN_TEAM_B=
API_TOKEN_PARTNER1=
API_TOKEN_PARTNER2=
# 工作台页面自身取数用。HTML 里只写占位符 __B9_WEB_TOKEN__，
# 由 api/server.py 的 web_page() 在下发那一刻替换成真值。
API_TOKEN_WEB=

# 审批人 secret（ADR-003）：批准/拒绝原子能力申请、部署/回滚排序配置专用。
# 与页面 token 分离——页面 token 打开网页即拿到，不能让"能开页面"等于"能批变更"。
# 未配置时审批端点返回 503（fail-closed）。
API_TOKEN_APPROVER=
