# 币圈新闻爬虫环境变量模板
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件包含真实 key，已在仓库中直接存储（私有仓库）

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<your_mysql_password>
MYSQL_DATABASE=crypto_news

# OpenAI（gpt-5.4，TPM 500k）
OPENAI_API_KEY=<your_openai_api_key>
OPENAI_API_BASE=https://api.openai.com/v1

# X API（Bearer Token，用于 KOL 推文拉取）
X_BEARER_TOKEN=<your_x_bearer_token>

# CoinMarketCal（催化剂日历，free tier 3000 req/月）
COINMARKETCAL_API_KEY=<your_coinmarketcal_api_key>

# Flask API 服务配置
API_HOST=0.0.0.0
API_PORT=8080
API_SECRET_KEY=<your_api_secret_key>

