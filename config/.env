# 币圈新闻爬虫环境变量
# 此文件包含真实 API Key，仓库为私有，安全存储
# 最后更新：2026-07-26

# MySQL（云电脑本地）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=***REMOVED***
MYSQL_DATABASE=crypto_news

# OpenAI 官方 API（gpt-5.4，TPM 500k / RPM 500）
# 如需切回 ofox.ai：改 OPENAI_API_BASE=https://api.ofox.ai/v1（需先充值）
OPENAI_API_KEY=***REMOVED***
OPENAI_API_BASE=https://api.openai.com/v1

# X API Bearer Token（KOL 推文拉取，32 账号，192 req/天）
X_BEARER_TOKEN=***REMOVED***

# CoinMarketCal（催化剂日历，free tier，3000 req/月）
# 正确 base URL：https://api.coinmarketcal.com/v2（v1 developers 域名已弃用，返回 403）
COINMARKETCAL_API_KEY=***REMOVED***

# Flask API 服务
API_HOST=0.0.0.0
API_PORT=8080
API_SECRET_KEY=***REMOVED***
